<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/primary"
                    android:divider="@drawable/divider_transparent"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingLeft="24dp"
                    android:paddingTop="136dp"
                    android:paddingEnd="24dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="24dp"
                    android:showDividers="middle">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="100dp">

                        <ImageView
                            android:id="@+id/imageView5"
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            app:srcCompat="@android:mipmap/sym_def_app_icon" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider_transparent"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <TextView
                            android:id="@+id/txvProfileUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_extrabold"
                            android:text="Username"
                            android:textColor="@color/white"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/txvProfileRank"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/karla_medium"
                            android:text="Rank Name"
                            android:textColor="@color/primary_tint"
                            android:textSize="16sp"
                            android:textStyle="italic" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/lpiRank"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="50"
                            app:indicatorColor="@color/primary_tint"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="@color/primary_dark"
                            app:trackThickness="8dp" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/neutral_tint"
                    android:divider="@drawable/divider_transparent"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:showDividers="middle">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cdvRankRedirect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:divider="@drawable/divider_transparent"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:showDividers="middle">

                            <Button
                                android:id="@+id/btnProfileXPRank"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:backgroundTint="@color/transparent"
                                android:focusable="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/baseline_auto_awesome_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="32dp"
                                app:iconTint="@color/primary_dark" />

                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:focusable="false"
                                android:fontFamily="@font/karla_medium"
                                android:text="XP &amp; Ranks"
                                android:textColor="@color/neutral_dark"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnProfileXPRankChev"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:backgroundTint="@color/transparent"
                                android:focusable="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/baseline_chevron_right_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="32dp"
                                app:iconTint="@color/primary" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cdvAchievementRedirect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:divider="@drawable/divider_transparent"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:showDividers="middle">

                            <Button
                                android:id="@+id/btnProfileAchievements"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:backgroundTint="@color/transparent"
                                android:focusable="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/baseline_school_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="32dp"
                                app:iconTint="@color/primary_dark" />

                            <TextView
                                android:id="@+id/textView13"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:focusable="false"
                                android:fontFamily="@font/karla_medium"
                                android:text="Achievements"
                                android:textColor="@color/neutral_dark"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnProfileAchievementsChev"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:backgroundTint="@color/transparent"
                                android:focusable="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/baseline_chevron_right_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="32dp"
                                app:iconTint="@color/primary" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cdvLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:divider="@drawable/divider_transparent"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:showDividers="middle">

                            <Button
                                android:id="@+id/btnLogOut"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:backgroundTint="@color/transparent"
                                android:focusable="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/baseline_logout_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="32dp"
                                app:iconTint="@color/primary_dark" />

                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:focusable="false"
                                android:fontFamily="@font/karla_medium"
                                android:text="Log Out"
                                android:textColor="@color/neutral_dark"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnProfileLogOutChev"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:backgroundTint="@color/transparent"
                                android:focusable="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/baseline_chevron_right_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="32dp"
                                app:iconTint="@color/primary" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/xpHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_dark"
            android:divider="@drawable/divider_transparent"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingLeft="16dp"
            android:paddingTop="48dp"
            android:paddingEnd="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:showDividers="middle"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnRank"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/transparent"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/rank_1_scout" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:divider="@drawable/divider_transparent"
                android:gravity="center"
                android:orientation="horizontal"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/txvXP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/karla_medium"
                    android:text="0"
                    android:textAlignment="textEnd"
                    android:textColor="@color/white"
                    android:textSize="24sp" />

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="32dp"
                    android:layout_height="48dp"
                    app:tint="@color/primary_tint"
                    app:srcCompat="@drawable/baseline_auto_awesome_24" />
            </LinearLayout>

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/baseline_account_circle_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="40dp"
                app:iconTint="@color/primary_tint" />

        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:paddingBottom="16dp"
            app:itemIconTint="@color/primary_dark"
            app:itemTextColor="@color/primary_dark"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/nav_menu" />

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>