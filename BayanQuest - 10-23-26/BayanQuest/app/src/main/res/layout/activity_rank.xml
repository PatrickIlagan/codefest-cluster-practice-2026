<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_tint"
    android:orientation="vertical"
    tools:context=".RankActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/header_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingLeft="24dp"
                android:paddingTop="48dp"
                android:paddingEnd="24dp"
                android:paddingRight="24dp"
                android:paddingBottom="24dp">

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/transparent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/baseline_chevron_left_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="32dp"
                    app:iconTint="@color/primary_tint" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="Rank &amp; XP"
                    android:textColor="@color/white"
                    android:textSize="24sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@drawable/divider_transparent"
                android:orientation="vertical"
                android:padding="24dp"
                android:showDividers="middle">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/imvRank"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            tools:srcCompat="@drawable/rank_1_scout" />

                        <TextView
                            android:id="@+id/txvRankName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_extrabold"
                            android:text="Rank"
                            android:textAlignment="center"
                            android:textColor="@color/neutral_dark"
                            android:textSize="34sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:divider="@drawable/divider_transparent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:showDividers="middle">

                            <TextView
                                android:id="@+id/txvCurrentXP"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/karla_medium"
                                android:text="TextView"
                                android:textColor="@color/neutral"
                                android:textSize="16sp" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/lpiRank"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="5"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="50"
                                app:indicatorColor="@color/primary"
                                app:indicatorTrackGapSize="0dp"
                                app:trackColor="@color/primary_dark"
                                app:trackThickness="8dp" />

                            <TextView
                                android:id="@+id/txvGoalXP"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/karla_medium"
                                android:text="TextView"
                                android:textColor="@color/neutral"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnMissionRedirect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/primary"
                    android:fontFamily="@font/karla_medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Earn More XP"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAchievements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/primary_dark"
                    android:fontFamily="@font/karla_medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="My Achievements"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>