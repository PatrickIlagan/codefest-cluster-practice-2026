<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".MenuActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="112dp"
                android:divider="@drawable/divider_16"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="40dp"
                android:paddingEnd="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Menu"
                        android:textAppearance="@style/HeadlineMedium"
                        android:textColor="@color/primary50" />

                    <Button
                        android:id="@+id/btnCart"
                        style="@style/IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/primary20"
                        app:icon="@drawable/round_shopping_cart_24"
                        app:iconSize="24dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtSearchFood"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Search Food"
                            android:textAppearance="@style/Body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbarSize="0dp">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/cpgFoodCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip9"
                                    style="@style/ChipFilter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:text="All"
                                    android:textAppearance="@style/Body" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip8"
                                    style="@style/ChipFilter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:text="Rice Meals"
                                    android:textAppearance="@style/Body" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip7"
                                    style="@style/ChipFilter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:text="Noodles &amp; Pasta"
                                    android:textAppearance="@style/Body" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip6"
                                    style="@style/ChipFilter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:text="Snacks"
                                    android:textAppearance="@style/Body" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip"
                                    style="@style/ChipFilter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:text="Drinks &amp; Desserts"
                                    android:textAppearance="@style/Body" />

                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>

                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/neutral90">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!--item_card_food_menu-->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rcvFoodMenu"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:paddingBottom="32dp"
            app:itemActiveIndicatorStyle="@style/CustomIndicator"
            app:itemIconSize="28dp"
            app:itemIconTint="@color/primary20"
            app:itemTextAppearanceActive="@style/Body"
            app:itemTextAppearanceActiveBoldEnabled="false"
            app:itemTextAppearanceInactive="@style/Body"
            app:itemTextColor="@color/primary20"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="144dp"
            android:clickable="true"
            android:elevation="0dp"
            app:backgroundTint="@color/primary50"
            app:elevation="0dp"
            app:maxImageSize="32dp"
            app:srcCompat="@drawable/round_add_24"
            app:tint="@color/white" />
    </FrameLayout>
</LinearLayout>