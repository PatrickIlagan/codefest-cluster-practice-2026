<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="104dp"
            android:layout_height="104dp">

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/food_chicken_adobo" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txvFoodName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Food Name"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TitleMedium"
                    android:textColor="@color/primary20" />

                <TextView
                    android:id="@+id/txvFoodCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Category"
                    android:textAppearance="@style/TitleSmall" />

                <TextView
                    android:id="@+id/txvFoodAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="PHP 00.00"
                    android:textAppearance="@style/Body"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnAdminEdit"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary20"
                    app:icon="@android:drawable/ic_menu_preferences"
                    app:iconSize="24dp" />

                <Button
                    android:id="@+id/btnAdminDelete"
                    style="@style/IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary20"
                    app:icon="@drawable/round_arrow_downward_24"
                    app:iconSize="24dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>