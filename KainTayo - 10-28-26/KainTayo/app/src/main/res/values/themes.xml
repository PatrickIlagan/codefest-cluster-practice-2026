    <style name="CustomTIL" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/neutral80</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="boxStrokeColor">@color/primary50</item>
    </style>

    <style name="IconButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="backgroundTint">@color/primary20</item>
        <item name="iconTint">@color/neutral90</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Button" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="backgroundTint">@color/primary50</item>
        <item name="iconTint">@color/neutral90</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textAppearance">@style/Body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/neutral90</item>
    </style>

    <style name="ChipFilter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/primary20</item>
        <item name="strokeColor">@color/primary20</item>
        <item name="android:textColor">@color/neutral90</item>
        <item name="chipCornerRadius">8dp</item>
    </style>

    <style name="CustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary80</item>
    </style>
