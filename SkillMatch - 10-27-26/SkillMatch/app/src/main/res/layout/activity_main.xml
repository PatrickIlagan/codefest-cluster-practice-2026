<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/primary20"
                    android:divider="@drawable/divider_16"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:paddingTop="40dp"
                    android:paddingEnd="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/txvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="-0.01"
                        android:text="Welcome, Username!"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/pagerBento"
                            android:layout_width="match_parent"
                            android:layout_height="210dp" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tabDots"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:background="@color/transparent" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@drawable/divider_16"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="112dp"
                    android:showDividers="middle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@drawable/divider_8"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <LinearLayout
                            android:id="@+id/bento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:divider="@drawable/divider_8"
                            android:orientation="horizontal"
                            android:showDividers="middle">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/primary20">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter"
                                        android:letterSpacing="-0.01"
                                        android:paddingTop="8dp"
                                        android:text="Overall Opportunities"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                        android:textColor="@color/primary80" />

                                    <TextView
                                        android:id="@+id/txvTotalOpportunities"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_black"
                                        android:text="0"
                                        android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                                        android:textColor="@color/white" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/primary20">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter"
                                        android:letterSpacing="-0.01"
                                        android:paddingTop="8dp"
                                        android:text="Saved Opportunities"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                        android:textColor="@color/primary80" />

                                    <TextView
                                        android:id="@+id/txvSavedOpportunities"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_black"
                                        android:text="0"
                                        android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                                        android:textColor="@color/white" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quickActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:divider="@drawable/divider_8"
                            android:orientation="horizontal"
                            android:showDividers="middle">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/crdOpportunities"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="0.8"
                                android:clickable="true"
                                app:cardBackgroundColor="@color/primary50">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                    <ImageView

                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        app:tint="@color/white"
                                        app:srcCompat="@drawable/baseline_business_center_24" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_bold"
                                        android:letterSpacing="-0.01"
                                        android:text="Opportunities"
                                        android:textAlignment="center"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                        android:textColor="@color/white" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/crdBookmarks"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:clickable="true"
                                app:cardBackgroundColor="@color/primary80">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                    <ImageView

                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        app:tint="@color/primary20"
                                        app:srcCompat="@drawable/baseline_bookmarks_24" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_bold"
                                        android:letterSpacing="-0.01"
                                        android:text="Bookmarks"
                                        android:textAlignment="center"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                        android:textColor="@color/primary20" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/crdProfile"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:clickable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="8dp">

                                    <ImageView
                                        android:id="@+id/imageView"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        app:tint="@color/primary20"
                                        app:srcCompat="@drawable/baseline_person_24" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_bold"
                                        android:letterSpacing="-0.01"
                                        android:text="Profile"
                                        android:textAlignment="center"
                                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                                        android:textColor="@color/primary20" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/topOpportunities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider_8"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_bold"
                                android:letterSpacing="-0.01"
                                android:text="Top Opportunities"
                                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                android:textColor="@color/primary20" />

                            <Button
                                android:id="@+id/btnOpportunities"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/baseline_chevron_right_24"
                                app:iconGravity="textStart"
                                app:iconSize="40dp"
                                app:iconTint="@color/primary50" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/neutral90"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rcvTopOpportunities"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recentSaved"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@drawable/divider_8"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_bold"
                                android:letterSpacing="-0.01"
                                android:text="Recently Saved"
                                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                android:textColor="@color/primary20" />

                            <Button
                                android:id="@+id/btnBookmarks"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/baseline_chevron_right_24"
                                app:iconGravity="textStart"
                                app:iconSize="40dp"
                                app:iconTint="@color/primary50" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/neutral90"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rcvRecentlySaved"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:paddingBottom="16dp"
            app:compatShadowEnabled="false"
            app:itemActiveIndicatorStyle="@style/CustomActiveIndicator"
            app:itemIconSize="28dp"
            app:itemIconTint="@color/primary20"
            app:itemTextAppearanceActive="@style/BottomNavTextAppearanceActive"
            app:itemTextAppearanceActiveBoldEnabled="true"
            app:itemTextAppearanceInactive="@style/BottomNavTextAppearanceInactive"
            app:itemTextColor="@color/primary20"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu" />
    </FrameLayout>
</LinearLayout>