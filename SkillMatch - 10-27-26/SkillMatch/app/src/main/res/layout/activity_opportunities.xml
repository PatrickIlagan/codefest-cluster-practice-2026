<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".OpportunitiesActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_16"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingTop="40dp"
                android:paddingEnd="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="24dp"
                android:showDividers="middle">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:letterSpacing="-0.01"
                    android:text="Job Opportunities"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textColor="@color/primary50" />

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider_8"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:showDividers="middle">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:endIconDrawable="@drawable/baseline_search_24"
                            app:endIconMode="custom">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/btnSearchOpportunities"
                                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="Search Opportunities"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnFilterMatch"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:backgroundTint="@color/primary20"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:icon="@drawable/baseline_arrow_upward_24"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="32dp"
                            app:iconTint="@color/primary80" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider_8"
                        android:orientation="horizontal"
                        android:showDividers="middle">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomEDM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/edmCategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="@color/transparent"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/CustomEDM"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/edmSkills"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="@color/transparent"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="@color/neutral90"
                        app:strokeWidth="0dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rcvOpportunities"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:paddingBottom="16dp"
            app:compatShadowEnabled="false"
            app:itemActiveIndicatorStyle="@style/CustomActiveIndicator"
            app:itemIconSize="28dp"
            app:itemIconTint="@color/primary20"
            app:itemTextAppearanceActive="@style/BottomNavTextAppearanceActive"
            app:itemTextAppearanceActiveBoldEnabled="true"
            app:itemTextAppearanceInactive="@style/BottomNavTextAppearanceInactive"
            app:itemTextColor="@color/primary20"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu" />
    </FrameLayout>

</LinearLayout>