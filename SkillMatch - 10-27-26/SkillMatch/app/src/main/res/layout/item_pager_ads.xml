<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/frm1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:tint="@color/primary2040"
                app:srcCompat="@drawable/img_card1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/black40"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="100% Discount!"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.05"
                    android:text="IF YOU WORK WITH US"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="-0.01"
                    android:padding="8dp"
                    android:text="Only here at Glow Glow Glow"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/white"
                    android:textStyle="italic" />
            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/frm2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:tint="@color/primary2040"
                app:srcCompat="@drawable/img_card2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/black40"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="Start your adventure now"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                    android:textColor="@color/white"
                    app:lineHeight="35sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.05"
                    android:text="Be a flight attendant and fly with us!"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/white"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="-0.01"
                    android:padding="8dp"
                    android:text="Buy tickets now at Scam Scam Scam"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/white" />
            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/frm3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:tint="@color/primary2040"
                app:srcCompat="@drawable/img_card3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/black40"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="TAKE THE RISK"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.05"
                    android:text="Be our lab test for $1.5T"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="-0.01"
                    android:padding="8dp"
                    android:text="Only here at Glow Glow Glow"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/white"
                    android:textStyle="italic" />
            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/frm4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:tint="@color/primary2040"
                app:srcCompat="@drawable/img_card4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/black40"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="Are you good at making drinks?"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                    android:textColor="@color/white"
                    app:lineHeight="40sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.05"
                    android:text="MAKE BEST-SELLING JUICE HERE"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="-0.01"
                    android:padding="8dp"
                    android:text="Apply now at Booty Booty Pop Juice"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/white" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>