<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral90"
    android:orientation="vertical"
    android:paddingTop="24dp"
    tools:context=".ProductActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView23"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_black"
                    android:letterSpacing="-0.03"
                    android:text="Products"
                    android:textColor="@color/primary50"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:boxBackgroundColor="@color/white"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/neutral70"
                        app:boxStrokeWidth="0dp"
                        app:endIconDrawable="@drawable/baseline_search_24"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtProductSearch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Search Product"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnDateFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/primary20"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/baseline_calendar_month_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scrollbarSize="0dp">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/cpgProductCategory"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:clickable="true"
                                    android:text="All"
                                    android:textColor="@color/white"
                                    app:chipBackgroundColor="@color/primary20"
                                    app:chipStrokeWidth="0dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip2"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:clickable="true"
                                    android:text="Canned &amp; Packaged"
                                    android:textColor="@color/white"
                                    app:chipBackgroundColor="@color/primary20"
                                    app:chipStrokeWidth="0dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip3"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:clickable="true"
                                    android:text="Rice &amp; Grains"
                                    android:textColor="@color/white"
                                    app:chipBackgroundColor="@color/primary20"
                                    app:chipStrokeWidth="0dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip4"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:clickable="true"
                                    android:text="Beverages &amp; Dairies"
                                    android:textColor="@color/white"
                                    app:chipBackgroundColor="@color/primary20"
                                    app:chipStrokeWidth="0dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip5"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checkable="true"
                                    android:clickable="true"
                                    android:text="Snacks &amp; Personal Care"
                                    android:textColor="@color/white"
                                    app:chipBackgroundColor="@color/primary20"
                                    app:chipStrokeWidth="0dp" />
                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="96dp"
                        app:cardBackgroundColor="@color/neutral70"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rcvProduct"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="120dp"
            android:clickable="true"
            app:backgroundTint="@color/primary50"
            app:elevation="0dp"
            app:fabSize="auto"
            app:maxImageSize="32dp"
            app:srcCompat="@drawable/baseline_add_circle_24"
            app:tint="@color/white" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:paddingBottom="16dp"
            app:itemActiveIndicatorStyle="@style/CustomIndicator"
            app:itemIconTint="@color/primary20"
            app:itemTextColor="@color/primary20"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu" />
    </FrameLayout>
</LinearLayout>